DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=example.com,localhost,127.0.0.1
TIME_ZONE=UTC

# PostgreSQL (recommended for the multi-user production site)
# Use the connection URL from your database provider. Some hosted providers
# require `?sslmode=require` at the end of the URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Email (password reset)
# For local dev you can keep the default console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
